{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudeal",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "none"
  },
  "triggers": {
    "crons": ["*/15 * * * *", "0 16 * * *", "10 */6 * * *", "25 */6 * * *", "40 */6 * * *"]
  },
  "vars": {
    "OCR_DAILY_LIMIT": "100"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mudeal-db",
      "database_id": "c80e64a5-59b9-416c-8232-8f3c176c0347",
      "migrations_dir": "migrations"
    }
  ]
}
