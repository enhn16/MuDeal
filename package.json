{
  "name": "mudeal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mudeal-db --local",
    "db:seed:local": "wrangler d1 execute mudeal-db --local --file=src/db/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vinext": "^1.4.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
